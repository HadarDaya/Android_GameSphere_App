<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Base.Theme.GameSphere" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Custom Font -->
        <item name="android:fontFamily">@font/montserrat_regular</item>

        <item name="android:windowBackground">@drawable/background_gradient</item>
        <!-- Primary app colors -->
        <item name="colorPrimary">@color/black</item>
        <item name="colorSecondary">@color/neon_pink</item>
        <item name="colorPrimaryVariant">@color/neon_pink</item>
        <item name="colorOnPrimary">@color/neon_pink</item>

        <item name="android:textColorHint">@color/white</item>

        <!-- Background & Surface -->
        <item name="colorSurface">@color/neon_pink</item>
        <item name="colorOnSurface">@color/black</item>

        <!-- Button & Accent Colors -->
        <item name="colorAccent">@color/neon_pink</item>

        <!-- Toolbar text color -->
        <item name="android:textColorPrimary">@color/white</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/black</item>

        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/black</item>

    </style>

    <style name="Theme.GameSphere" parent="Base.Theme.GameSphere" />
</resources>