<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.AddNewGameFragment">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

        <!-- Game Name -->
        <EditText
            android:id="@+id/addGameFrag_gameName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Game Name"
            android:inputType="text"
            android:textColor="@color/white"
            android:textColorHint="@android:color/darker_gray"
            android:textSize="16sp"
            tools:ignore="Autofill,HardcodedText" />

        <!-- Developer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Developer: "
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <Spinner
                android:id="@+id/addGameFrag_developer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:padding="8dp"
                android:spinnerMode="dropdown" />
        </LinearLayout>

        <!-- Genre -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Genre: "
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/addGameFrag_genre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:text="Select"
                android:textColor="@color/white"
                android:textSize="16sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- Platform -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Platform: "
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/addGameFrag_platform"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:text="Select"
                android:textColor="@color/white"
                android:textSize="16sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- Publisher -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Publisher: "
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <Spinner
                android:id="@+id/addGameFrag_publisher"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="8dp"
                android:spinnerMode="dropdown"
                android:backgroundTint="@color/white"/>
        </LinearLayout>

        <!-- Series -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Series: "
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <Spinner
                android:id="@+id/addGameFrag_series"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="8dp"
                android:spinnerMode="dropdown"
                android:backgroundTint="@color/white"/>
        </LinearLayout>

        <!-- Description -->
        <EditText
            android:id="@+id/addGameFrag_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Description"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:textColor="@color/white"
            android:textColorHint="@android:color/darker_gray"
            android:textSize="16sp"
            tools:ignore="Autofill,HardcodedText" />

        <!-- Release Year -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:text="Release Year:"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText,InefficientWeight" />

            <TextView
                android:id="@+id/addGameFrag_releaseYear"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginLeft="5dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:text="Select"
                android:textColor="@color/white"
                android:textSize="16sp"
                tools:ignore="HardcodedText,RtlHardcoded" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:chipSpacing="8dp"
            app:singleSelection="false">

            <!-- Single Player Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/addGameFrag_singlePlayer"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Single Player"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:checked="false"
                app:checkedIconTint="@color/white"
                app:chipIconVisible="false"
                app:chipBackgroundColor="@color/gray"
                app:closeIconVisible="false"
                tools:ignore="HardcodedText" />

            <!-- Multi Player Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/addGameFrag_multiPlayer"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Multi Player"
                android:textColor="@color/white"
                app:chipBackgroundColor="@color/gray"
                android:textSize="16sp"
                android:checked="false"
                app:checkedIconTint="@color/white"
                app:chipIconVisible="false"
                app:closeIconVisible="false"
                tools:ignore="HardcodedText" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Game Image -->
        <TextView
            android:id="@+id/addGameFrag_gameImageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Game Image: "
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <ImageView
            android:id="@+id/addGameFrag_selectedImage"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:contentDescription="Selected Game Image"
            android:focusable="true"
            android:src="@drawable/select_image"
            tools:ignore="HardcodedText" />

        <!-- YouTube URL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YouTube URL: "
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <EditText
                android:id="@+id/addGameFrag_youtubeUrl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="https://youtu.be/URL"
                android:inputType="textUri"
                android:textColor="@color/white"
                android:textColorHint="@android:color/darker_gray"
                android:textSize="16sp"
                tools:ignore="Autofill,HardcodedText" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="25dp"
            android:weightSum="0.7">

            <!-- Clear Button -->
            <Button
                android:id="@+id/addGameFrag_clear"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0.1"
                android:text="Clear"
                android:textColor="@color/neon_pink"
                app:strokeColor="@color/neon_pink"
                tools:ignore="HardcodedText" />

            <!-- Submit Button -->
            <Button
                android:id="@+id/addGameFrag_submit"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_weight="0.5"
                android:text="Add"
                android:textColor="@color/neon_pink"
                app:strokeColor="@color/neon_pink"
                tools:ignore="HardcodedText,RtlHardcoded" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

    <!-- Fullscreen Loading Animation Overlay -->
    <FrameLayout
        android:id="@+id/addGameFrag_loadingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone"
        android:alpha="0.8">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/addGameFrag_loadingAnimation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            app:lottie_rawRes="@raw/loading_lottie"
            app:lottie_autoPlay="false"
            app:lottie_loop="true"/>
    </FrameLayout>
</FrameLayout>