<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeFrag_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <!-- ImageView -->
                <ImageView
                    android:id="@+id/image"
                    android:layout_width="300dp"
                    android:layout_height="250dp"
                    android:src="@drawable/home_decor"
                    android:contentDescription="decoration"
                    android:rotation="20"
                    android:scaleType="centerCrop"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="HardcodedText" />

                <!-- "GameSphere" Title -->
                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_extrabold"
                    android:text="GameSphere"
                    android:textColor="@color/white"
                    android:textSize="40sp"
                    android:padding="4dp"
                    android:alpha="0.9"
                    app:layout_constraintStart_toEndOf="@id/image"
                    app:layout_constraintBottom_toTopOf="@id/subtitle"
                    app:layout_constraintTop_toTopOf="@id/image"
                    tools:ignore="HardcodedText" />

                <!-- Subtitle ("Discover your next adventure!") -->
                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Discover\nyour next adventure!"
                    android:textColor="@color/white"
                    android:textSize="30sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:padding="8dp"
                    android:alpha="0.7"
                    app:layout_constraintStart_toEndOf="@id/image"
                    app:layout_constraintBottom_toBottomOf="@id/image"
                    tools:ignore="HardcodedText" />
            </androidx.constraintlayout.widget.ConstraintLayout>


            <LinearLayout
                android:id="@+id/homeFrag_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:elevation="8dp">

                <!-- Filter icon -->
                <ImageButton
                    android:id="@+id/homeFrag_btnOpenFilters"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical|end"
                    android:background="@drawable/filter_icon"
                    android:contentDescription="btnOpenFilters"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp"
                    tools:ignore="HardcodedText" />

                <!-- Filters count -->
                <TextView
                    android:id="@+id/homeFrag_filterCountText"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="-9dp"
                    android:background="@drawable/filter_count_shape"
                    android:paddingTop="1dp"
                    android:text="2"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@+id/homeFrag_btnOpenFilters"
                    app:layout_constraintHorizontal_bias="0.803"
                    app:layout_constraintStart_toStartOf="@+id/homeFrag_btnOpenFilters"
                    tools:ignore="HardcodedText,SmallSp" />

                <!-- Search Bar -->
                <SearchView
                    android:id="@+id/homeFrag_search"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.6"
                    android:backgroundTint="@color/white"
                    android:backgroundTintMode="add"
                    android:closeIcon="@drawable/baseline_close"
                    android:queryHint="Game Search..."
                    android:searchHintIcon="@drawable/baseline_search"
                    android:searchIcon="@drawable/baseline_search"
                    app:iconifiedByDefault="false" />

                <!-- Sort options -->
                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sort By"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    tools:ignore="HardcodedText,RtlHardcoded,RtlSymmetry"
                    android:paddingRight="8dp"/>

                <Spinner
                    android:id="@+id/homeFrag_sort_sortSpinner"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.4"
                    android:spinnerMode="dropdown"
                    android:backgroundTint="@color/white"/>

                <!-- Sort arrow -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/homeFrag_sort_btnSortArrow"
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    app:icon="@drawable/baseline_arrow_upward"
                    app:iconGravity="textEnd"
                    app:iconPadding="0dp"
                    app:iconTint="@color/white" />

            </LinearLayout>

            <!-- RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homeFrag_recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- No Data Animation -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/homeFrag_noDataAnimation"
            android:layout_width="500dp"
            android:layout_height="500dp"
            android:layout_gravity="center"
            android:layout_marginTop="80dp"
            android:visibility="gone"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/no_data_lottie" />

        <!-- Fullscreen Loading Animation Overlay -->
        <FrameLayout
            android:id="@+id/homeFrag_loadingContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:visibility="gone"
            android:alpha="0.8">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/homeFrag_loadingAnimation"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                app:lottie_rawRes="@raw/loading_lottie"
                app:lottie_autoPlay="false"
                app:lottie_loop="true"/>
        </FrameLayout>
    </FrameLayout>

    <!-- Sidebar Filters -->
    <LinearLayout
        android:id="@+id/homeFrag_filter_sidebar"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@color/black"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Filter Games"
            android:textColor="@color/link_blue"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="5dp"
            android:textAlignment="center"
            tools:ignore="HardcodedText" />

        <!-- Developer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Developer: "
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/homeFrag_filter_developer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:text="Select"
                android:textSize="16sp"
                android:textColor="@color/white"
                tools:ignore="HardcodedText,InefficientWeight" />
        </LinearLayout>

        <!-- Genre -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Genre: "
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/homeFrag_filter_genre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:text="Select"
                android:textSize="16sp"
                android:textColor="@color/white"
                tools:ignore="HardcodedText,InefficientWeight" />
        </LinearLayout>

        <!-- Platform -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Platform: "
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/homeFrag_filter_platform"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:text="Select"
                android:textSize="16sp"
                android:textColor="@color/white"
                tools:ignore="HardcodedText,InefficientWeight" />
        </LinearLayout>

        <!-- Publisher -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Publisher: "
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/homeFrag_filter_publisher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:text="Select"
                android:textSize="16sp"
                android:textColor="@color/white"
                tools:ignore="HardcodedText,InefficientWeight" />
        </LinearLayout>

        <!-- Series -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Series: "
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/homeFrag_filter_series"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:text="Select"
                android:textSize="16sp"
                android:textColor="@color/white"
                tools:ignore="HardcodedText,InefficientWeight" />
        </LinearLayout>

        <!-- Release Year -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:text="Release Year:"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                tools:ignore="HardcodedText,InefficientWeight" />

            <TextView
                android:id="@+id/homeFrag_filter_releaseYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:text="Select"
                android:textSize="16sp"
                android:textColor="@color/white"
                tools:ignore="HardcodedText,RtlHardcoded" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:chipSpacing="8dp"
            app:singleSelection="false">

            <!-- Single Player Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/homeFrag_filter_singlePlayer"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Single Player"
                app:checkedIconTint="@color/white"
                app:chipBackgroundColor="@color/gray"
                android:textSize="16sp"
                app:chipIconVisible="false"
                app:closeIconVisible="false"
                android:textColor="@color/white"
                tools:ignore="HardcodedText" />

            <!-- Multi Player Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/homeFrag_filter_multiPlayer"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Multi Player"
                app:checkedIconTint="@color/white"
                app:chipBackgroundColor="@color/gray"
                android:textSize="16sp"
                app:chipIconVisible="false"
                app:closeIconVisible="false"
                android:textColor="@color/white"
                tools:ignore="HardcodedText" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Rate -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:text="Rating:"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                tools:ignore="HardcodedText,InefficientWeight" />
            <!-- Button Toggle Group -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/homeFrag_filter_toggleRateButtonGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.google.android.material.button.MaterialButton
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7+"
                    android:textColor="@color/link_blue"
                    app:strokeColor="@color/link_blue"
                    tools:ignore="HardcodedText" />

                <com.google.android.material.button.MaterialButton
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8+"
                    android:textColor="@color/link_blue"
                    app:strokeColor="@color/link_blue"
                    tools:ignore="HardcodedText" />

                <com.google.android.material.button.MaterialButton
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9+"
                    android:textColor="@color/link_blue"
                    app:strokeColor="@color/link_blue"
                    tools:ignore="HardcodedText" />

            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <!-- Clear Button -->
            <Button
                android:id="@+id/homeFrag_filter_clear"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginRight="20dp"
                android:text="Clear"
                android:textColor="@color/neon_pink"
                app:strokeColor="@color/neon_pink"
                tools:ignore="HardcodedText,RtlHardcoded" />
            <!-- Apply Filters Button -->
            <Button
                android:id="@+id/homeFrag_filter_btnApplyFilters"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Apply Filters"
                android:textColor="@color/neon_pink"
                app:strokeColor="@color/neon_pink"
                tools:ignore="HardcodedText" />
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>