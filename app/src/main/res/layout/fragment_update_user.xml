<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragment.UpdateUserFragment"
    android:gravity="center"
    android:orientation="vertical">

    <!-- Update details Animation Lottie-->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/loginFrag_decorLottie"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/update_user_lottie" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="30dp"
        app:cardCornerRadius="30dp"
        app:cardElevation="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@color/almost_black">

            <!-- Email-->
            <EditText
                android:id="@+id/updateDetailsFrag_email"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:drawableLeft="@drawable/baseline_email"
                android:drawablePadding="8dp"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:padding="8dp"
                android:textColor="@color/white"
                android:textColorHighlight="@color/cardview_dark_background"
                tools:ignore="Autofill,HardcodedText,RtlHardcoded" />

            <!-- Username-->
            <EditText
                android:id="@+id/updateDetailsFrag_username"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:drawableLeft="@drawable/baseline_person_white"
                android:drawablePadding="8dp"
                android:hint="Username"
                android:inputType="textVisiblePassword"
                android:padding="8dp"
                android:textColor="@color/white"
                android:textColorHighlight="@color/cardview_dark_background"
                tools:ignore="Autofill,HardcodedText,RtlHardcoded" />

            <!-- Add CheckBox for changing password -->
            <CheckBox
                android:id="@+id/updateDetailsFrag_changePasswordCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Change Password"
                android:textColor="@color/white"
                tools:ignore="HardcodedText" />

            <!-- These fields will be hidden initially and shown only when checkbox is checked -->
            <LinearLayout
                android:id="@+id/changePasswordFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- New password-->
                <EditText
                    android:id="@+id/updateDetailsFrag_newPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:drawableLeft="@drawable/baseline_lock"
                    android:drawablePadding="8dp"
                    android:hint="New Password"
                    android:textColorHint="@android:color/darker_gray"
                    android:inputType="textPassword"
                    android:padding="8dp"
                    android:textColor="@color/white"
                    tools:ignore="Autofill,HardcodedText,RtlHardcoded" />

                <!-- Verify password-->
                <EditText
                    android:id="@+id/updateDetailsFrag_verifyPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:drawableLeft="@drawable/baseline_lock"
                    android:drawablePadding="8dp"
                    android:hint="Verify Password"
                    android:textColorHint="@android:color/darker_gray"
                    android:inputType="textPassword"
                    android:padding="8dp"
                    android:textColor="@color/white"
                    tools:ignore="Autofill,HardcodedText,RtlHardcoded" />
            </LinearLayout>

            <!-- Save Button-->
            <Button
                android:id="@+id/updateDetailsFrag_updateButton"
                style="?attr/materialButtonOutlinedStyle"
                app:strokeColor="@color/neon_pink"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="30dp"
                android:text="Save"
                android:textColor="@color/neon_pink"
                android:textSize="18sp"
                tools:ignore="HardcodedText" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
